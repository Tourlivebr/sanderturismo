                class="absolute z-10 w-full mt-1 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-64 overflow-y-auto hidden"
              >
                <div class="p-2 space-y-1">
                  {passeios.map((passeio) => (
                    <label class="flex items-center p-2 hover:bg-gray-50 dark:hover:bg-gray-600 rounded cursor-pointer transition-colors">
                      <input
                        type="checkbox"
                        name="passeios"
                        value={passeio}
                        class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 dark:border-gray-600 rounded mr-3"
                      />
                      <span class="text-sm text-gray-700 dark:text-gray-300 leading-5">
                        {passeio}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            </div>

            <!-- Tags dos itens selecionados -->
            <div id="selectedTags" class="mt-3 flex flex-wrap gap-2 min-h-[24px]"></div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
              💡 Clique no menu acima para selecionar múltiplos itens. Ajuste faixas e quantidades abaixo.
            </p>
          </div>

          <!-- PAINEL DINÂMICO: configurações por item selecionado + resumo -->
          <div id="painelValores" class="space-y-4 hidden">
            <div class="relative">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-dashed border-gray-200 dark:border-gray-600"></div>
              </div>
              <div class="relative flex justify-center text-sm">
                <span class="px-3 bg-white dark:bg-gray-800 text-primary-700 dark:text-primary-300 font-semibold">
