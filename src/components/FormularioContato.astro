    faixas:[{rotulo:"1 a 4 passageiros",preco:180},{rotulo:"5 a 6 passageiros",preco:320}] },
  "City Tour Nova Petrópolis": { tipo:"privativo", unidade:"por veículo",
    faixas:[{rotulo:"1 a 4 passageiros",preco:320},{rotulo:"5 a 6 passageiros",preco:400}] },
  "Lumni Transporte": { tipo:"privativo", unidade:"por veículo (ida e volta)",
    faixas:[{rotulo:"1 a 4 passageiros",preco:200},{rotulo:"5 a 6 passageiros",preco:300}] },
  "Trem Maria Fumaça": { tipo:"privativo", unidade:"por pacote",
    faixas:[{rotulo:"1 a 2 passageiros",preco:1300},{rotulo:"Até 6 passageiros",preco:2999.90}] },
  "Tour Vinhos e Sabores": { tipo:"ingresso", unidade:"por pessoa",
    faixas:[{rotulo:"Por pessoa (todas as idades)",preco:229}] }
};
const TODOS_ITENS = Object.keys(TABELA_VALORES);

function fmtBRL(v){
  return "R$ "+(Number(v)||0).toLocaleString("pt-BR",{minimumFractionDigits:2,maximumFractionDigits:2});
}
function slug(s){ return s.toLowerCase().normalize("NFD").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,""); }

// ==============================
// 2) FUNÇÃO CENTRALIZADA: calcular valor de 1 item
// ==============================
function calcularValorItem(nome, qtd = 1, faixaIdx = 0){
  const cfg = TABELA_VALORES[nome];
  if(!cfg) return 0;
  const faixa = cfg.faixas[faixaIdx] || cfg.faixas[0];
  const precoUnit = faixa?.preco || 0;
  if (cfg.tipo === "privativo") return Number(precoUnit.toFixed(2));
  const q = Math.max(0, Math.floor(qtd || 0));
  return Number((precoUnit * q).toFixed(2));
}

// ==============================
// 3) ESTADO: guarda configurações de cada item selecionado
// ==============================
const estado = {
  // [nomeItem] => { faixaIdx, qtd }
};

document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('contactForm');
  const telefoneInput = document.getElementById('telefone');

  const dropdownButton = document.getElementById('passeiosDropdown');
  const dropdownMenu = document.getElementById('passeiosMenu');
  const dropdownIcon = document.getElementById('dropdownIcon');
  const selectedText = document.getElementById('passeiosSelected');
  const selectedTags = document.getElementById('selectedTags');
  const painelValores = document.getElementById('painelValores');
  const itensSelecionadosEl = document.getElementById('itensSelecionados');
  const resumoTotalEl = document.getElementById('resumoTotal');
  const resumoQtdEl = document.getElementById('resumoQtd');
  const checkboxes = dropdownMenu.querySelectorAll('input[type="checkbox"]');

  function buildWhatsAppUrl(phoneDigits, text) {
    const normalized = String(text).replace(/\r\n/g, '\n');
    const textoCodificado = encodeURIComponent(normalized);
    const numero = String(phoneDigits).replace(/\D/g, '');
    const isMobile = /Android|iPhone|iPad|iPod|Windows Phone/i.test(navigator.userAgent);
    if (isMobile) return `https://wa.me/${numero}?text=${textoCodificado}`;
    return `https://api.whatsapp.com/send?phone=${numero}&text=${textoCodificado}`;
  }

  // --- Dropdown controle ---
  dropdownButton.addEventListener('click', function(e) {
    e.preventDefault();
    const isOpen = !dropdownMenu.classList.contains('hidden');
    if (isOpen) { dropdownMenu.classList.add('hidden'); dropdownIcon.style.transform = 'rotate(0deg)'; }
    else { dropdownMenu.classList.remove('hidden'); dropdownIcon.style.transform = 'rotate(180deg)'; }
  });
  document.addEventListener('click', function(e) {
    if (!dropdownButton.contains(e.target) && !dropdownMenu.contains(e.target)) {
      dropdownMenu.classList.add('hidden');
      dropdownIcon.style.transform = 'rotate(0deg)';
    }
  });

  // ==============================
  // 4) RENDER painel de valores por item
  // ==============================
  function renderPainelItens(){
    const selecionados = Array.from(checkboxes).filter(cb => cb.checked).map(cb => cb.value);

    // Mostra/esconde painel inteiro
    if (selecionados.length === 0) {
      painelValores.classList.add('hidden');
    } else {
      painelValores.classList.remove('hidden');
    }
    resumoQtdEl.textContent = selecionados.length;

    // Inicializa estado default para itens recém selecionados
    selecionados.forEach(nome => {
      if (!estado[nome]) estado[nome] = { faixaIdx: 0, qtd: 1 };
    });

    // Limpa estados de itens removidos
    Object.keys(estado).forEach(nome => {
      if (!selecionados.includes(nome)) delete estado[nome];
    });

    // Renderiza um bloco por item
    itensSelecionadosEl.innerHTML = '';
    selecionados.forEach(nome => {
      const cfg = TABELA_VALORES[nome];
      if (!cfg) return;
      const st = estado[nome];
      const bloco = document.createElement('div');
      bloco.className = 'rounded-xl border border-gray-200 dark:border-gray-600 p-3 lg:p-4 bg-white dark:bg-gray-700/40 space-y-3';
      const idBase = 'it-' + slug(nome);

      // Faixa de preço (select sempre existe)
      const faixaOptions = cfg.faixas.map((f,i) =>
        `<option value="${i}" ${i===st.faixaIdx?'selected':''}>${f.rotulo} • ${fmtBRL(f.preco)}${cfg.tipo==='privativo'?' / '+cfg.unidade:' / pessoa'}</option>`
      ).join('');

      // Qtd: só para ingressos (por pessoa). Para privativos, é 1 veículo/pacote.
      const qtdBlock = cfg.tipo === 'ingresso' ? `
        <div>
          <label for="${idBase}-qtd" class="block text-xs font-semibold text-gray-600 dark:text-gray-300 mb-1">
            Quantidade de pessoas
          </label>
          <input type="number" min="1" max="99" step="1" value="${st.qtd}"
            data-nome="${nome}" data-tipo="qtd"
            id="${idBase}-qtd"
            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-500 rounded-lg dark:bg-gray-700 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        </div>` : `
        <input type="hidden" data-nome="${nome}" data-tipo="qtd" value="1">`;

      const subtotal = calcularValorItem(nome, st.qtd, st.faixaIdx);

      bloco.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div class="flex-1">
            <p class="font-bold text-sm lg:text-base text-gray-900 dark:text-white">${nome}</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
              <span class="inline-block px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-600 text-gray-700 dark:text-gray-200 mr-1.5">
                ${cfg.tipo === 'privativo' ? 'Privativo' : 'Ingresso'}
              </span>
              ${cfg.unidade}
            </p>
          </div>
          <button type="button" data-nome="${nome}" data-remove
            class="shrink-0 text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
            aria-label="Remover">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <label for="${idBase}-fx" class="block text-xs font-semibold text-gray-600 dark:text-gray-300 mb-1">
              ${cfg.tipo === 'privativo' ? 'Faixa de passageiros' : 'Tipo de ingresso / faixa'}
            </label>
            <select id="${idBase}-fx" data-nome="${nome}" data-tipo="faixa"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-500 rounded-lg dark:bg-gray-700 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              ${faixaOptions}
            </select>
          </div>
          ${qtdBlock}
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-dashed border-gray-200 dark:border-gray-600">
          <span class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-semibold">Subtotal</span>
          <span data-nome="${nome}" data-subtotal class="text-lg font-extrabold text-primary-700 dark:text-primary-300">${fmtBRL(subtotal)}</span>
        </div>
      `;

      itensSelecionadosEl.appendChild(bloco);
    });

    // ========= Atualiza total =========
    recalcularTotal();

    // ========= Liga listeners no painel =========
    itensSelecionadosEl.querySelectorAll('[data-tipo]').forEach(inp => {
      inp.addEventListener('change', onInputItemChange);
      if (inp.tagName === 'INPUT') inp.addEventListener('input', onInputItemChange);
    });
    itensSelecionadosEl.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', function(){
        const nome = this.getAttribute('data-nome');
        const cb = Array.from(checkboxes).find(c => c.value === nome);
        if (cb) { cb.checked = false; updateSelections(); }
      });
    });
  }

  function onInputItemChange(e){
    const nome = e.currentTarget.getAttribute('data-nome');
    const tipo = e.currentTarget.getAttribute('data-tipo');
    if (!estado[nome]) estado[nome] = { faixaIdx: 0, qtd: 1 };
    if (tipo === 'faixa') estado[nome].faixaIdx = Number(e.currentTarget.value) || 0;
    if (tipo === 'qtd') {
      const v = parseInt(e.currentTarget.value, 10);
      estado[nome].qtd = isNaN(v) ? 1 : Math.max(1, v);
    }
    recalcularTotal();
  }

  function recalcularTotal(){
    let total = 0;
    itensSelecionadosEl.querySelectorAll('[data-subtotal]').forEach(subEl => {
      const nome = subEl.getAttribute('data-nome');
      const st = estado[nome] || { faixaIdx:0, qtd:1 };
      const valor = calcularValorItem(nome, st.qtd, st.faixaIdx);
      subEl.textContent = fmtBRL(valor);
      total += valor;
    });
    resumoTotalEl.textContent = fmtBRL(total);
  }

  // ==============================
  // 5) Atualizar seleções (dropdown + tags + painel)
  // ==============================
  function updateSelections() {
    const selected = Array.from(checkboxes).filter(cb => cb.checked).map(cb => cb.value);

    if (selected.length === 0) {
      selectedText.textContent = 'Selecione os passeios/ingressos...';
      selectedText.className = 'text-gray-500 dark:text-gray-400';
    } else if (selected.length === 1) {
      selectedText.textContent = selected[0];
      selectedText.className = 'text-gray-900 dark:text-white';
    } else {
      selectedText.textContent = `${selected.length} itens selecionados`;
      selectedText.className = 'text-gray-900 dark:text-white';
    }

    // Tags
    selectedTags.innerHTML = '';
    selected.forEach(passeio => {
      const tag = document.createElement('span');
      tag.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
      const escaped = passeio.replace(/"/g, '&quot;');
      tag.innerHTML = `
        ${escaped}
        <button type="button" class="ml-1.5 text-blue-600 hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-100" aria-label="Remover ${escaped}" data-remove-tag>
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
        </button>
      `;
      selectedTags.appendChild(tag);
    });
    selectedTags.querySelectorAll('[data-remove-tag]').forEach((btn, i) => {
      btn.addEventListener('click', function(){
        const nome = selected[i];
        const cb = Array.from(checkboxes).find(c => c.value === nome);
        if (cb) { cb.checked = false; updateSelections(); }
      });
    });

    // Renderiza painel de valores (com 0.5ms para não travar clique no checkbox)
    requestAnimationFrame(() => renderPainelItens());
  }

  // Expor remover (compatibilidade com a tag inline onclick anterior, agora removida)
  window.removeSelection = function(nome) {
    const cb = Array.from(checkboxes).find(cb => cb.value === nome);
    if (cb) { cb.checked = false; updateSelections(); }
  };

  checkboxes.forEach(cb => cb.addEventListener('change', updateSelections));

  // Máscara telefone
  telefoneInput.addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length <= 11) {
      if (value.length <= 2) value = value.replace(/(\d{0,2})/, '($1');
      else if (value.length <= 7) value = value.replace(/(\d{2})(\d{0,5})/, '($1) $2');
      else value = value.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
    }
    e.target.value = value;
  });

  // ==============================
  // 6) SUBMIT: montar WhatsApp com total calculado
  // ==============================
  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(form);
    const nome = String(formData.get('nome') || '').trim();
    const dia = String(formData.get('dia') || '').padStart(2, '0');
    const mes = String(formData.get('mes') || '');
    const ano = String(formData.get('ano') || '');
    const telefone = String(formData.get('telefone') || '').trim();
    const mensagem = String(formData.get('mensagem') || 'Nenhuma mensagem adicional').trim();

    const selecionados = Array.from(checkboxes).filter(cb => cb.checked).map(cb => cb.value);

    if (!nome || !dia || !mes || !ano || !telefone) {
      alert('Por favor, preencha todos os campos obrigatórios.');
      return;
    }
    if (selecionados.length === 0) {
      alert('Por favor, selecione pelo menos um passeio ou ingresso.');
      return;
    }

    // Recalcula TUDO novamente no submit (garantia: NÃO depende só do que aparece na tela)
    let totalGeral = 0;
    const linhas = [];
    const detalhes = [];

    selecionados.forEach((nomeItem, idx) => {
      const cfg = TABELA_VALORES[nomeItem];
      if (!cfg) return;
      const st = estado[nomeItem] || { faixaIdx:0, qtd:1 };
      const faixa = cfg.faixas[st.faixaIdx] || cfg.faixas[0];
      const qtd = cfg.tipo === 'privativo' ? 1 : Math.max(1, Math.floor(st.qtd||1));
      const valorItem = calcularValorItem(nomeItem, qtd, st.faixaIdx);
      totalGeral += valorItem;

      linhas.push(`${idx+1}. ${nomeItem}`);

      let linhaDet = `   • ${faixa.rotulo} • ${fmtBRL(faixa.preco)}`;
      if (cfg.tipo === 'ingresso') linhaDet += ` × ${qtd} ${qtd===1?'pessoa':'pessoas'}`;
      else linhaDet += ` • ${cfg.unidade}`;
      linhaDet += `  →  Subtotal: ${fmtBRL(valorItem)}`;
      detalhes.push(linhaDet);
    });

    const dataFormatada = `${dia}/${mes}/${ano}`;
    totalGeral = Number(totalGeral.toFixed(2));

    const msg =
`🌟 *Solicitação de Passeios / Ingressos* 🌟

👤 *Nome:* ${nome}
📅 *Data Desejada:* ${dataFormatada}

🎯 *Itens selecionados (${selecionados.length}):*
${linhas.join('\n')}

🧾 *Detalhamento dos valores:*
${detalhes.join('\n')}

💰 *VALOR TOTAL ESTIMADO:* ${fmtBRL(totalGeral)}
*Observação:* valores sujeitos à confirmação de disponibilidade.

📱 *Telefone/WhatsApp:* ${telefone}
💬 *Mensagem adicional:* ${mensagem}

📍 *Enviado através do site* — Passeios Gramado Canela
⏰ *${new Date().toLocaleString('pt-BR')}*`;

    const numeroWhatsApp = '5554992065626';
    const urlWhatsApp = buildWhatsAppUrl(numeroWhatsApp, msg);

    try {
      window.open(urlWhatsApp, '_blank', 'noopener,noreferrer');
    } catch (err) {
      console.error('Falha ao abrir WhatsApp:', err);
      alert('Não foi possível abrir o WhatsApp. Tente novamente.');
      return;
    }

    // Limpar form
    form.reset();
    Object.keys(estado).forEach(k => delete estado[k]);
    updateSelections();

    const button = form.querySelector('button[type="submit"]');
    const originalText = button.innerHTML;
    button.innerHTML = `
      <svg class="w-6 h-6 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Redirecionando...
    `;
    setTimeout(() => (button.innerHTML = originalText), 2000);
  });

  // Primeiro update (garante que dropdown inicial mostre "Selecione...")
  updateSelections();
});
</script>
