/* Lista amigável dos itens exibidos no dropdown (ordem: ParksNet primeiro → Kongo → demais ingressos → depois passeios/translados) */
const passeios = [
  // Ingressos e Atrações (ordem exata dos cards)
  "ParksNet Passaporte",
  "Kongo Pizzaria",
  "Parque da Mônica",
  "Era do Fogo Fondue Temático",
  "Ferrovia Secreta Hector",
  "Hector Pizzaria",
  "Gatzz Fondue & Show",
  "Passaporte Grupo Dreams",
  // Passeios e Transferes (ordem exata dos cards)
  "Transfer IDA e VOLTA • Porto Alegre / Gramado ou Canela",
  "City Tour Privativo",
  "Transporte Olivas",
  "Transporte Jolimont",
  "Transporte Sky Glass",
  "Bondinhos Transporte",
  "City Tour Nova Petrópolis",
  "Lumni Transporte",
  "Trem Maria Fumaça",
  "Tour Vinhos e Sabores",
];

/** FUNÇÃO CENTRALIZADA: calcula o valor de 1 item selecionado
  @param {string} nome - Nome EXATO do passeio/ingresso na TABELA_VALORES
  @param {number} qtd - Quantidade para ingressos (pessoas) OU 1 (padrão) para privativos
  @param {number?} faixaIdx - Índice da faixa selecionada (0, 1, 2...)
  @returns {number} valor em reais
*/
function calcularValorItem(nome, qtd = 1, faixaIdx = 0) {
  const cfg = TABELA_VALORES[nome];
  if (!cfg) return 0;
  const precoUnit = cfg.faixas[faixaIdx]?.preco ?? cfg.faixas[0]?.preco ?? 0;
  if (cfg.tipo === "privativo") return precoUnit;
  return precoUnit * Math.max(0, Math.floor(qtd || 0));
}
---
<section class="relative pb-8 lg:pb-12 pt-0">
  <div class="max-w-7xl mx-auto px-4 py-8 relative z-20">
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 lg:gap-12 items-start">
    <!-- Coluna Esquerda: Texto e Orientações -->
    <div class="order-1 xl:order-1 space-y-6 lg:space-y-8">
      <div class="text-center">
        <h2 class="text-2xl lg:text-3xl xl:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Reserve Seu Passeio dos Sonhos!
        </h2>

        <!-- Balão de Fala -->
        <div class="relative bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-700 dark:to-gray-600 rounded-3xl p-4 lg:p-6 shadow-lg animate-pulse">
          <div class="text-center">
            <p class="text-base lg:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
              Escolha os passeios, que nós montamos a melhor programação para você e sua família! 
              <span class="font-semibold text-blue-600 dark:text-blue-400">É rápido e gratuito!</span>
            </p>
          </div>
          <!-- Seta do balão -->
