const { slug } = Astro.params;
const passeio = passeiosData[slug];

if (!passeio) {
  return Astro.redirect('/404');
}

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}. Valor: R$ ${passeio.preco.toFixed(2).replace('.', ',')} em ${passeio.parcelas}.`;
const whatsappUrl = `https://wa.me/5554992065626?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - ${passeio.subtitulo} | Passeios Gramado Canela - Gramado e Canela`}
  description={`${passeio.descricao} Com a Passeios Gramado Canela, sua experiência na Serra Gaúcha é garantida!`}
  keywords={[passeio.titulo.toLowerCase(), 'passeios Gramado', 'passeios Canela', 'Passeios Gramado Canela', 'Serra Gaúcha']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden">
      <img 
        src={passeio.galeria[0]} 
        alt={passeio.titulo}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre este passeio</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria</h3>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity">
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                    onclick={`openModal('${imagem}')`}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar de Reserva com Formulário -->
        <div class="lg:col-span-1">
          <div class="sticky top-32">
            <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-lg" data-sidebar-preco>
              <FormReserva
                passeioNome={passeio.titulo}
                passeioParcelas={passeio.label1}
                passeioPreco={passeio.price1}
                passeioPreco1={passeio.price1}
                passeioPreco2={passeio.price2}
                passeioLabel1={passeio.label1}
                passeioLabel2={passeio.label2}
                passeioTemFaixas={passeio.temFaixas}
                passeioDuracao={passeio.duracao}
                passeioHorarios={passeio.horarios}
                passeioCategoria={passeio.categoria}
                passeioFaixasCompletas={(passeio as any).faixasCompletas}
                passeioTemTabelaCompleta={(passeio as any).temTabelaCompleta}
                ehTransferIdaVolta={slug === 'transfer-ida-volta-porto-alegre'}
                temContadorPessoas={slug === 'tour-vinhos-e-sabores'}
                precoPorPessoa={slug === 'tour-vinhos-e-sabores' ? 229 : undefined}
                precoCheioPorPessoa={slug === 'tour-vinhos-e-sabores' ? 229 : undefined}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para Galeria -->
  <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl"
      >
        ✕
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function openModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageSrc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Fechar modal ao clicar fora da imagem
  const imgModal = document.getElementById('imageModal');
  if (imgModal) {
    imgModal.addEventListener('click', function(e) {
      if (e.target === this) {
        closeModal();
      }
    });
  }

  // Inicializar seletores de faixa de pessoas (seletor grande e sidebar)
  document.querySelectorAll('[data-price-selector]').forEach(sel => {
    const temFaixas = sel.dataset.temFaixas === 'true';
    if (!temFaixas) return;
    const btns = sel.querySelectorAll('.faixa-pessoas-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const faixa = btn.dataset.faixa; // "1" ou "2"
        btns.forEach(b => {
          b.classList.remove('border-primary-500', 'ring-2', 'ring-primary-500');
          b.classList.add('border-gray-200');
        });
        btn.classList.remove('border-gray-200');
        btn.classList.add('border-primary-500', 'ring-2', 'ring-primary-500');
        // Dispara evento global para atualizar sidebar
        window.dispatchEvent(new CustomEvent('faixa-pessoas-mudou', { detail: { faixa } }));
      });
    });
  });
</script>