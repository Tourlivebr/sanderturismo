---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroQuemSou from '../components/HeroQuemSou.astro';
import CarrosselPasseios from '../components/CarrosselPasseios.astro';
import CarrosselPasseiosReceptivo from '../components/CarrosselPasseiosReceptivo.astro';
import Depoimentos from '../components/Depoimentos.astro';
import FormularioContato from '../components/FormularioContato.astro';
import Footer from '../components/Footer.astro';

const seoDescription = "Passeios Gramado Canela - O seu guia completo de turismo em Gramado e Canela! Translados, passeios, ingressos para atrações e muito mais na Serra Gaúcha. Reserve já!";
const seoKeywords = [
  "turismo Gramado",
  "turismo Canela",
  "translado Gramado",
  "translado Canela",
  "ingressos Gramado",
  "passeios Serra Gaúcha",
  "Passeios Gramado Canela",
  "Gramado RS",
  "Canela RS"
];
---

<BaseLayout 
  title="Passeios Gramado Canela | Turismo em Gramado e Canela - Serra Gaúcha" 
  description={seoDescription}
  keywords={seoKeywords}
  image="/images/logo_p_pgc_t.png"
>
  <Header />
  
  <!-- Seção Hero -->
  <HeroQuemSou />
  
  <!-- Seção de Passeios e Receptivo -->
  <section id="passeios">
    <CarrosselPasseiosReceptivo />
  </section>
  
  <!-- Seção de Ingressos e Atrações -->
  <section id="ingressos">
    <CarrosselPasseios />
  </section>
  
  <!-- Seção Depoimentos -->
  <section id="depoimentos">
    <Depoimentos />
  </section>
  
  <!-- Seção Contato -->
  <section id="contato" class="bg-white dark:bg-gray-800">
    <FormularioContato />
  </section>
  
  <!-- Footer -->
  <Footer />
</BaseLayout>
